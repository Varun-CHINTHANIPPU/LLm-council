#!/usr/bin/env bash
# Run Council's existing two-file general-purpose LLM Council workflow.
set -euo pipefail

cd -- "$(dirname -- "${BASH_SOURCE[0]}")"

if [[ -x .venv/bin/python ]]; then
    PYTHON=.venv/bin/python
else
    PYTHON=python3
fi

exec "$PYTHON" -m council.cli --mode full --task-type auto --deadline 600 "$@"
